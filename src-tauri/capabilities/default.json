{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: every command of the app; opens links and folders, and asks for files",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "allow-system-locales",
    "allow-get-settings",
    "allow-get-status",
    "allow-save-settings",
    "allow-set-hotkey-suspended",
    "allow-get-last-result",
    "allow-retry-available",
    "allow-retry-dictation",
    "allow-connect-chatgpt",
    "allow-cancel-chatgpt-sign-in",
    "allow-open-chatgpt-usage",
    "allow-get-permissions",
    "allow-request-permission",
    "allow-recent-apps",
    "allow-list-input-devices",
    "allow-list-languages",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-model-download",
    "allow-delete-model",
    "allow-data-folders",
    "allow-open-data-folder",
    "allow-list-cloud-engines",
    "allow-add-connection",
    "allow-remove-connection",
    "allow-refresh-connection-models",
    "allow-get-history",
    "allow-delete-history-entry",
    "allow-clear-history",
    "allow-get-stats",
    "allow-reset-stats",
    "allow-delete-history-file",
    "allow-fit-tray-panel",
    "allow-hide-tray-panel",
    "allow-open-main-window",
    "allow-quit-app",
    "allow-transcribe-file",
    "allow-cancel-file",
    "allow-save-held-result",
    "allow-replace-connection-key",
    "allow-export-replacements",
    "allow-import-replacements",
    "allow-get-meetings",
    "allow-get-meeting",
    "allow-start-meeting",
    "allow-stop-meeting",
    "allow-discard-meeting",
    "allow-transcribe-meeting",
    "allow-cancel-meeting-transcription",
    "allow-delete-meeting",
    "allow-rename-meeting",
    "allow-export-meeting",
    "allow-get-speaker-models",
    "allow-download-speaker-models",
    "allow-delete-speaker-models",
    "allow-install-update"
  ]
